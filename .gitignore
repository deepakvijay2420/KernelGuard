# ==========================================
# KernelGuard Git Ignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.key
*.pem
*.secret
secrets/
credentials/

# API keys / local configuration
google_api_key.txt
openai_api_key.txt

# Compiled binaries / objects
*.o
*.so
*.a
*.out

# KernelGuard generated binaries
ebpf/kernelguard_reader
ebpf/exec_monitor
ebpf/zta/zta_controller
ebpf/zta/zta_enforcer.bpf.o
ebpf/zta/zta_controller

# Backup / temporary source files
*backup*
*_backup.*
*.backup
*.old
*.bak
*~
*.tmp
*.swp

# Runtime logs
logs/
*.log

# Runtime traces
traces/

# Temporary experiment files
tmp/

# Generated ML models
*.joblib
*.pkl
*.pickle

# Generated experiment outputs
# Keep curated research results in Git, but ignore temporary files.
results/**/tmp/
results/**/logs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python test/cache
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
